# Local demo works with these blank — PGLite + preview auth.
# Fill them in for a real deploy (Neon + OAuth).

# Postgres (Neon). Leave empty to use in-memory PGLite.
DATABASE_URL=

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# Set to "false" for a no-login local demo (jobs board uses a dev user).
VITE_AUTH_ENABLED=true

# Optional: Imagine SMS for booking photo quotes
XAI_API_KEY=

# --- Stripe: Seasonal Cleanup Plan (auto-renewing annual subscription) ---
# LIVE vs TEST is decided ENTIRELY by which key is here. There is no mode flag
# in the code and there must never be one.
# Use a RESTRICTED key (rk_live_...), not a standard secret key — this Stripe
# account is shared with other ventures. Scope it to: Customers write, Checkout
# Sessions write, Subscriptions write, Billing Portal Sessions write,
# Products + Prices read.
# Scope to the Production deploy context only: a preview build with a live key
# can charge real cards.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# One Stripe Price id per lot tier. Prices are immutable in Stripe — to change
# an amount you archive the price and create a new one, then swap the id here.
# That indirection is the whole reason these are env vars.
STRIPE_PRICE_SMALL=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_LARGE=

# --- Statutory pre-renewal notice (NDCC ch. 51-37) ---
# North Dakota requires WRITTEN notice 30-60 days before each automatic
# renewal. Stripe's invoice.upcoming fires only days ahead and CANNOT satisfy
# this. Without these two set, the daily job refuses to mark any notice as sent
# and reports a failing run — auto-renewing plans must not be sold until they
# are configured.
RESEND_API_KEY=
# MUST be an address on a domain verified in Resend. A gmail.com / outlook.com
# / yahoo.com address CANNOT work: you can only verify a domain you own, and
# those providers' DMARC policies reject third-party senders. senderConfigured()
# rejects them outright rather than letting the plan go on sale with notices
# that are guaranteed to bounce.
RENEWAL_FROM_EMAIL=hello@pickitupe.com
# Where replies land. The renewal notice's whole job is "you're about to be
# charged, here's how to stop it", so people reply to it — put a real monitored
# inbox here (a personal Gmail is perfectly fine as the REPLY-TO).
RENEWAL_REPLY_TO=

# Shared secret for the daily renewal-notice sweep. Any long random string.
CRON_SECRET=

# --- "Have more questions?" answer box (src/lib/chat-actions.ts) ---
# Claude Haiku. Without it the box tells visitors to text the owner instead,
# which is a correct answer, not a broken state.
# The model NEVER computes a price: every number it can say is rendered from
# pricebook.ts into its system prompt server-side. Do not loosen that — the
# whole site's credibility rests on numbers the owner can defend.
ANTHROPIC_API_KEY=
